events {}
http {
  resolver 127.0.0.11 valid=5s ipv6=off;
  server {
    listen 8080;
    merge_slashes on;
    location = /reload { return 404; }
    location = /stub_status { return 404; }
    location / {
      set $audit_backend audit-svc:8080;
      proxy_pass http://$audit_backend;
      proxy_set_header Host $host;
    }
  }
  server {
    listen 8081;
    location = /stub_status { stub_status; }
    location / { return 404; }
  }
}
